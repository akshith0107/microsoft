APP_ENV=development
APP_NAME=Kirana AI Backend
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kirana_db

JWT_SECRET_KEY=dev_secret_key_change_in_production_1234567890
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Gemini LLM & Vision Provider (Set real Gemini API key for LIVE mode)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# Hindsight Experiential Memory AI (Set real Hindsight API key for LIVE mode)
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_BASE_URL=https://api.hindsight.ai/v1
HINDSIGHT_API_URL=https://api.hindsight.ai/v1

# Sarvam AI Speech-to-Text & Text-to-Speech (Set real Sarvam API key for LIVE mode)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_BASE_URL=https://api.sarvam.ai

# External Integrations
WEATHER_API_KEY=mock_weather_key
WEATHER_API_URL=https://api.weather.com/v1

AGMARKNET_API_URL=https://agmarknet.gov.in/api/v1
AGMARKNET_API_KEY=mock_agmarknet_key

WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_ACCESS_TOKEN=mock_whatsapp_token
WHATSAPP_PHONE_NUMBER_ID=mock_whatsapp_phone_id

CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174
